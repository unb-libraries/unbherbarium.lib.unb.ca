{
  "authors": [
    {
      "name": "UNB Libraries libsupport@unb.ca",
      "role": "Creator"
    }
  ],
  "autoload": {
    "classmap": [
      "scripts/composer/ScriptHandler.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupal/core-composer-scaffold": true,
      "phpstan/extension-installer": true,
      "php-http/discovery": true,
      "tbachert/spi": true,
      "symfony/runtime": true
    },
    "discard-changes": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "conflict": {
    "drupal/drupal": "*"
  },
  "description": "Drupal 8 component of unbherbarium.lib.unb.ca",
  "extra": {
    "enable-patching": true,
    "drupal-scaffold": {
      "locations": {
        "web-root": "./"
      }
    },
    "installer-paths": {
      "core": [
        "type:drupal-core"
      ],
      "libraries/{$name}": [
        "type:drupal-library"
      ],
      "modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "themes/contrib/{$name}": [
        "type:drupal-theme"
      ],
      "Commands/contrib/{$name}": [
        "type:drupal-drush"
      ],
      "modules/custom/{$name}": [
        "type:drupal-custom-module"
      ],
      "profiles/custom/{$name}": [
        "type:drupal-custom-profile"
      ],
      "themes/custom/{$name}": [
        "type:drupal-custom-theme"
      ]
    },
    "patches": {
      "drupal/search_api": {
        "Drupal 11 schema fixes": "/build/patches/search_api_8.x-1.x_schema.patch"
      }
    }
  },
  "license": "MIT",
  "minimum-stability": "dev",
  "name": "unb-libraries/unbherbarium.lib.unb.ca",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    {
      "package": {
        "dist": {
          "type": "zip",
          "url": "https://github.com/douglascrockford/JSON-js/archive/master.zip"
        },
        "extra": {
          "installer-name": "json2"
        },
        "name": "jquery/json2",
        "type": "drupal-library",
        "version": "dev-master"
      },
      "type": "package"
    },
    {
      "package": {
        "dist": {
          "type": "file",
          "url": "https://malsup.github.io/jquery.cycle.all.js"
        },
        "name": "malsup/jquery.cycle",
        "require": {
          "composer/installers": "^2"
        },
        "type": "drupal-library",
        "version": "1.0"
      },
      "type": "package"
    },
    {
      "type": "package",
      "package": {
        "name": "jackmoore/colorbox",
        "version": "1.6.4",
        "type": "drupal-library",
        "dist": {
          "url": "https://github.com/jackmoore/colorbox/archive/refs/tags/1.6.4.zip",
          "type": "zip"
        }
      }
    },
    {
      "package": {
        "dist": {
          "type": "zip",
          "url": "https://github.com/harvesthq/chosen/releases/download/v1.8.7/chosen_v1.8.7.zip"
        },
        "name": "harvesthq/chosen",
        "require": {
          "composer/installers": "^2"
        },
        "type": "drupal-library",
        "version": "1.8.7"
      },
      "type": "package"
    }
  ],
  "require": {
    "drupal/admin_toolbar": "3.x-dev",
    "drupal/bootstrap": "^5",
    "drupal/chosen": "^4",
    "drupal/colorbox": "^2",
    "drupal/config_update": "^2",
    "drupal/core": "^11",
    "drupal/core-composer-scaffold": "^11",
    "drupal/core-recommended": "^11",
    "drupal/csv_serialization": "^4",
    "drupal/editor_file": "^2",
    "drupal/field_group": "^4",
    "drupal/footnotes": "^4",
    "drupal/google_analytics": "^4",
    "drupal/health_check": "^3",
    "drupal/honeypot": "^2",
    "drupal/migrate_plus": "^6",
    "drupal/migrate_source_csv": "^3",
    "drupal/migrate_tools": "^6",
    "drupal/pathauto": "^1",
    "drupal/redis": "^1",
    "drupal/samlauth": "^3",
    "drupal/search_api": "^1",
    "drupal/search_api_solr": "^4",
    "drupal/simple_entity_merge": "^1",
    "drupal/simple_gmap": "^3",
    "drupal/simple_sitemap": "^4",
    "drupal/taxonomy_access_fix": "^4",
    "drupal/taxonomy_manager": "^2",
    "drupal/theme_switcher": "^2",
    "drupal/token": "^1",
    "drupal/tvi": "^2",
    "drupal/twig_field_value": "^2",
    "drupal/views_autocomplete_filters": "^2",
    "drupal/views_slideshow": "^5",
    "harvesthq/chosen": "^1",
    "jackmoore/colorbox": "^1",
    "jquery/json2": "dev-master",
    "league/csv": "^9",
    "malsup/jquery.cycle": "^1",
    "neitanod/forceutf8": "^2",
    "teqneers/php-stream-wrapper-for-git": "^1",
    "unb-libraries/composer-drupal-scaffold": "^11",
    "unb-libraries/saml_features": "dev-10.x-1.x"
  },
  "require-dev": {
    "unb-libraries/drupal-development-libraries": "^11"
  },
  "type": "project"
}
